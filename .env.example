# Copia este archivo a .env y completa el token. NUNCA subas .env al repositorio.

# Token del bot (portal de desarrolladores de Discord > Bot > Reset Token). Obligatorio.
DISCORD_TOKEN=

# Nivel de logs: DEBUG, INFO, WARNING, ERROR. Opcional (por defecto INFO).
LOG_LEVEL=INFO

# Prefijo de comandos de texto adicional a "º". Opcional (por defecto "!").
COMMAND_PREFIX=!

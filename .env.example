# Copia este archivo a .env y completa el token. NUNCA subas .env al repositorio.

# Token del bot (portal de desarrolladores de Discord > Bot > Reset Token). Obligatorio.
DISCORD_TOKEN=

# Nivel de logs: DEBUG, INFO, WARNING, ERROR. Opcional (por defecto INFO).
LOG_LEVEL=INFO

# Prefijo de los comandos de texto (.play, .help...). Opcional (por defecto ".").
# Los comandos de aplicación (/play, /help...) funcionan siempre, sea cual sea.
COMMAND_PREFIX=.

# Canales donde se juega al casino (ruleta, blackjack y tragaperras): IDs
# separados por comas. Opcional.
# Vacío = cualquier canal. En nuestro servidor, #casino es 1384280704539562054.
CASINO_CHANNEL_IDS=

# Activity de Discord (`/jugar`, bot/cogs/actividad.py). Opcional: vacío = sin Activity.
# Secreto de la app: portal de desarrolladores > OAuth2 > Client Secret. Es SECRETO
# como el token. Con él, el bot sirve la Activity en el puerto 8765 (ver README).
DISCORD_CLIENT_SECRET=
# Servidor cuya economía usa la Activity cuando se abre fuera de un servidor con el bot
# (un mensaje directo o un servidor pequeño de pruebas). Opcional: un ID de servidor.
ACTIVITY_GUILD_ID=
